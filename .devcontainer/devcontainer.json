{
	"name": "Mularr Dev Environment",
	"image": "mcr.microsoft.com/devcontainers/typescript-node",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},
	"runArgs": [
		//"--network=container:myvpn-container"  Uncomment and set your VPN container name if needed
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	},
	"postCreateCommand": "bash ./.devcontainer/setup-amule.sh && cd frontend && npm install && cd ../backend && npm install"
}